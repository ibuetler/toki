[pocketbase]
url = http://127.0.0.1:8090
email = importer-superuser@example.invalid
password = REPLACE_LOCALLY

[sync]
# User connections and exclusion patterns are managed through Android/PocketBase.
settings_source = pocketbase
allowed_hosts = outlook.office365.com
# A bounded horizon keeps yearly/unbounded recurring calendars finite.
past_days = 7
future_days = 366
# Floating times and all-day dates use this zone.
timezone = Europe/Zurich
max_occurrences = 20000

# Legacy [calendar:...] / [exclude] sections are read only when settings_source=config.
# New installations add URLs and patterns in Android: Account > Calendars & exclusions.
